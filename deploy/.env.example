# =============================================================================
# Daytona Production Environment Configuration
# =============================================================================
# Copy this file to .env and update values for your deployment.
# Generate secure keys with: openssl rand -base64 32
# =============================================================================

# =============================================================================
# Required - Domain Configuration
# =============================================================================
# Your domain name (e.g., daytona.example.com)
DOMAIN=your-domain.com

# =============================================================================
# Required - Security Keys
# =============================================================================
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
ENCRYPTION_SALT=

# =============================================================================
# Required - Database
# =============================================================================
POSTGRES_PASSWORD=

# =============================================================================
# Required - MinIO Object Storage
# =============================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

# =============================================================================
# Required - API Keys for Inter-service Communication
# =============================================================================
# Generate with: openssl rand -hex 32
PROXY_API_KEY=
RUNNER_API_KEY=
SSH_GATEWAY_API_KEY=

# =============================================================================
# Optional - OIDC/URL Configurations (auto-configured from DOMAIN)
# =============================================================================
# Uncomment to override defaults

# OIDC public domain (used by browser for authentication)
# PUBLIC_OIDC_DOMAIN=https://${DOMAIN}/dex

# Dashboard URL
# DASHBOARD_URL=https://${DOMAIN}/dashboard
# DASHBOARD_BASE_API_URL=https://${DOMAIN}

# Proxy configuration
# PROXY_DOMAIN=proxy.${DOMAIN}:8443
# PROXY_PROTOCOL=https
# PROXY_TEMPLATE_URL=https://{{PORT}}-{{sandboxId}}.proxy.${DOMAIN}:8443
# PROXY_TOOLBOX_BASE_URL=https://proxy.${DOMAIN}:8443

# SSH Gateway URL
# SSH_GATEWAY_URL=${DOMAIN}:2222

# =============================================================================
# Optional - DNS Provider for SSL Certificate (Caddy)
# =============================================================================
# Uncomment and configure for your DNS provider

# For Aliyun DNS (alidns)
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=

# For Cloudflare DNS
# CLOUDFLARE_API_TOKEN=

# For AWS Route53
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# =============================================================================
# Optional - ZeroSSL EAB (External Account Binding)
# =============================================================================
# If using ZeroSSL instead of Let's Encrypt

# ZEROSSL_EAB_KID=
# ZEROSSL_EAB_HMAC_KEY=

# =============================================================================
# Optional - Dex Authentication
# =============================================================================
# Default admin user configuration

# DEX_ADMIN_EMAIL=admin@example.com
# DEX_ADMIN_PASSWORD=
# DEX_ADMIN_USERNAME=admin
